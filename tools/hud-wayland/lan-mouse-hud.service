[Unit]
Description=Lan Mouse HUD (Wayland overlay)
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
# gtk4-layer-shell must be loaded before GTK (Python cannot link it first)
Environment=LD_PRELOAD=/usr/lib/libgtk4-layer-shell.so GDK_BACKEND=wayland
ExecStart=/usr/bin/python3 %h/.local/lib/lan-mouse/lan-mouse-hud-wayland.py
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
